[t:template,n:base_{{stn}}_summon]
{
	specializes = {{stn}}_base;

	[attack]
	{
		damage_min = 0;
		damage_max = 0;
	}
	[magic]
	{
		{% set skill_factor = 1 - req_lvl/200 if req_lvl <= 50 else 0.75 + (req_lvl-50)/400 %}
		attack_damage_modifier_min = ((((#src_melee/{{ '%0.5g' | format(skill_factor) }})*4.2)*{{dmg | float}})*{{'%0.3g' | format(abf | sqrt_if(vanilla) if abf is number else 1)}})*{% if stable %}1.0{% else %}0.9{% endif %};
		attack_damage_modifier_max = ((((#src_melee/{{ '%0.5g' | format(skill_factor) }})*4.2)*{{dmg | float}})*{{'%0.3g' | format(abf | sqrt_if(vanilla) if abf is number else 1)}})*{% if stable %}1.0{% else %}1.1{% endif %};
	}
}
