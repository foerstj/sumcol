[t:template,n:xp_braak_base]  // = xp_braak
{
	category_name 	= "1W_evil_c";
	doc 			= "xp_braak";
	specializes 	= base_braak;
	[actor]
	{
		[skills]
		{
			strength 		= 11, 0;
			intelligence 	=  7, 0;
			dexterity 		=  8, 0;
			nature_magic 	=  7, 0;
			combat_magic	=  7, 0;
		}
	}
	[aspect]
	{
       	[textures] { 0=b_c_edm_ash_fiend; }	 
		experience_value 	= 234;
		life 				= 219;
		max_life 			= 219;
		mana 				=  1;
		max_mana 			=  1;
	}
	[attack]
	{
		attack_range 	= 0.5;
		damage_max 		= 25;
		damage_min 		= 20;
	}
	[common]
	{
		screen_name	= "Braak Lurker";
		membership 	= monster;
	}
	[defend] { defense = 45; }
	[inventory]
	{
		selected_active_location = il_active_primary_spell;
		[other] { il_active_primary_spell=xp_spell_braak; }
		[pcontent]
		{
			/* Generated: Tue Jun 17 11:13:15 2003
			Level 11, Weak */
			[oneof*]
			{
				[gold*]
				{
					chance = 0.2;
					min = 127;
					max = 253;
				}
				[oneof*]
				{
					chance = 0.2;
					il_main = potion_mana_small;
					il_main = potion_health_small;
				}
				[oneof*]
				{
					chance = 0.1;
					il_main = #weapon/20-30;
					il_main = #armor/7-62;
					il_main = #*/20-30;
				}
				[oneof*]
				{
					chance = 0.005;
					il_main = #weapon/-rare(1)/17-33;
					il_main = #armor/-rare(1)/34-62;
					il_main = #*/-rare(1)/17-33;
				}		
			}
		}
	}
	[mind]
	{
		actor_weapon_preference			= WP_MAGIC;
		actor_auto_switches_to_magic	= true;
		actor_auto_switches_to_karate	= false;
		actor_auto_switches_to_melee	= false;
		jat_fidget						= world\ai\jobs\common\job_fidget.skrit
			?social						= 0.5
			&meander					= false
			&still						= false;
	}

}
