[t:template,n:xp_zombie_karate_base]  // = xp_zombie_karate
{
	category_name = "1W_evil_d";
	doc = "xp_zombie_karate";
	specializes = xp_zombie_base;
	[actor]
	{
		[skills]
		{
			strength 		= 12, 0;
			intelligence 	=  7, 0;
			dexterity 		=  8, 0;
			melee 			=  8, 0;
		}
	}
	[aspect]
	{
		life			= 160;
		max_life		= 160;
		[voice]
		{
			[die]			{ priority = high; * = s_e_die_zaurask_zombie_01_SED;	 }
			[enemy_spotted]	{ priority = high; * = s_e_call_zaurask_zombie_01_SED; }
			[hit_solid]		{ priority = low; * = s_e_hit_zaurask_zombie_1_SED;	}
		}
	}
	[attack]
	{
		attack_range = 0.5;
		damage_max = 48; 
		damage_min = 32;
	}
	[body]
	{
		avg_move_velocity = 1.3;
		[weapon_scales]
		{
			as_single_melee = 1.0, 1.0, 1.0;
		}
	}
	[common]
	{
		screen_name = "Zaurask Zombie";
		membership = monster;
		[template_triggers]
		{
			[*]
			{
				action* = call_sfx_script("zaurask_zombie");
				condition* = receive_world_message("WE_ENTERED_WORLD");
				single_shot = true;
			}
			[*]
			{
				action* = call_sfx_script("zaurask_zombie_karate_die");
				condition* = receive_world_message("WE_KILLED");
				single_shot = true;
			}
		}
	}
	[defend] { defense = 85; }
	[inventory]
	{
		drop_at_use_point = true;
		[pcontent]
		{
			/* Generated: Tue Jun 17 11:13:15 2003
			Level 10, Medium */
			[oneof*]
			{
				[gold*]
				{
					chance = 0.2;
					min = 115;
					max = 229;
				}
				[oneof*]
				{
					chance = 0.2;
					il_main = potion_mana_small;
					il_main = potion_health_small;
				}
				[oneof*]
				{
					chance = 0.15;
					il_main = #weapon/20-28;
					il_main = #armor/6-53;
					il_main = #*/20-28;
				}
				[oneof*]
				{
					chance = 0.0075;
					il_main = #weapon/-rare(1)/22-33;
					il_main = #armor/-rare(1)/34-90;
					il_main = #*/-rare(1)/22-33;
				}
			
			}
		}
	}
	[mind]
	{
		jat_brain						= world\ai\jobs\common\brain_hero.skrit
			?actor_joins_existing_party	= true;
		jat_fidget						= world\ai\jobs\common\job_fidget.skrit;
		melee_engage_range = 14;
		personal_space_range = 0.7;
		ranged_engage_range = 14.0;
		sight_range = 14.0;
	}
}
