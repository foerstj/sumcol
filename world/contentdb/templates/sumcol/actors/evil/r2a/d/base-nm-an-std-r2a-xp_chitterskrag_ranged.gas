[t:template,n:xp_chitterskrag_ranged_base]  // = xp_chitterskrag_ranged
{
	category_name = "1W_evil_d";
	doc = "xp_chitterskrag_ranged";
	specializes = dsx_chitterskrag_base;
	[actor]
		{
		[skills]
		{
			strength 		= 12, 0;
			intelligence 	=  7, 0;
			dexterity 		=  8, 0;
			combat_magic	=  8, 0;
			nature_magic	=  8, 0;
		}
	}
	[aspect]
	{
		model 				= m_c_edm_chs_pos_2;
		textures:0 			= b_c_edm_chs_xp;
		experience_value 	= 117;
		life             	= 166;
		max_life         	= 166;
		mana             	= 1;
		max_mana         	= 1;
		scale_base 			= 1.0;
	}
	[attack]
	{
		attack_range = 0.5;
		damage_max = 32; 
		damage_min = 28;
	}
	[common]
	{
		screen_name = "Spewing Chitterskrag";
		membership = monster;
	}
	[defend] { defense = 85; }
	[body]
	{
		avg_move_velocity = 2.5;
		[chore_dictionary]
		{
			chore_prefix = a_c_edm_chs_fs;
			[chore_attack]
			{
				chore_stances = 0;
				skrit = select_attack;
				[anim_files]
				{
					00 = at;
					01 = at-02;
				}
			}
			[chore_default]
			{
				chore_stances = 0;
				skrit = infinite_loop;
				[anim_files] { 00=ds; }
			}
			[chore_die]
			{
				chore_stances = 0;
				skrit = select_transition;
				[anim_files] { 00=di; }
			}
			[chore_fidget]
			{
				chore_stances = 0;
				skrit = select_fidget;
				[anim_files] { 00=dsf; }
			}
			[chore_walk]
			{
				chore_stances = 0;
				skrit = select_walk;
				[anim_files] 
				{ 
					00=rl;  
				}
			}
			[chore_magic]
			{
				chore_stances = 0;
				skrit = select_attack;
				[anim_files]{ 00=mg; }
			}
		}
	}
	[mind]
	{
		jat_brain						= world\ai\jobs\common\brain_hero.skrit
		?actor_joins_existing_party		= true;
		
		actor_weapon_preference			= WP_MAGIC;
		actor_auto_switches_to_magic	= true;
		actor_auto_switches_to_karate	= false;
		actor_auto_switches_to_melee	= false;
		
		personal_space_range = 0.75;
	}
	[inventory]
	{
		selected_active_location = il_active_primary_spell;
		[other] { il_active_primary_spell=xp_spell_chitterskrag; }
		[pcontent]{}
	}
}
