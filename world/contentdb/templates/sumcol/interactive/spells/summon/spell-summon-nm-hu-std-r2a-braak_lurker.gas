[t:template,n:spell_summon_braak_lurker] { specializes = spell_summon_braak_lurker_base; }
[t:template,n:spell_summon_braak_lurker_base]
{
	specializes = base_spell_sumcol_nm;

	doc = "spell Summon Braak Lurker";
	[aspect]
	{
		gold_value = 3800;
	}
	[common]
	{
		screen_name = "Summon Braak Lurker";
		description = "Summons a Braak Lurker to guard the Caster.";
	}
	[gui]
	{
		active_icon =   b_gui_ig_i_ic_sp_sumcol-nm-hu-std-r2a-braak_lurker;
		inventory_icon =b_gui_ig_i_ic_sp_sumcol-nm-hu-std-r2a-braak_lurker-inv;
	}
	[spell_summon]
	{
		template_name = xp_braak_summon;
		script_params = "[scale(1.5)]";
	}
	[magic]
	{
		effect_duration = 420;
		mana_cost = 0;
		mana_cost_modifier = (#magic+1)*(18+0);
		required_level = 21;
		max_level = 41;

		[enchantments]
		{
			[*]
			{
				alteration = alter_cmagic_damage_min;
				duration = #infinite;
				value = ((((((#magic*4.2)*0.8)*0.4)*0.9) - #cmagic_damage_min) - 20.0);
			}
			[*]
			{
				alteration = alter_cmagic_damage_max;
				duration = #infinite;
				value = ((((((#magic*4.2)*0.8)*0.4)*1.1) - #cmagic_damage_max) - 25.0);
			}
			[*]
			{
				alteration = alter_armor;
				duration = #infinite;
				value = (((#magic*4.2)*1.5) - #base_defense);
			}
			[*]
			{
				alteration = alter_max_life;
				duration = #infinite;
				value = ((((#magic*12)+(#spell_req_level*12))*1.0) - #maxlife);
			}
			[*]
			{
				alteration = alter_life;
				duration = 1.0;
				value = (((#magic*12)+(#spell_req_level*12))*1.0);
			}
			[*]
			{
				alteration = alter_combat_magic;
				duration = #infinite;
				value = ((#magic*0.895)-#combat_magic_level);
			}
			[*]
			{
				alteration = alter_strength;
				duration = #infinite;
				value = (((#magic*0.64)+10) - #str);
			}
			[*]
			{
				alteration = alter_dexterity;
				duration = #infinite;
				value = (((#magic*0.27)+10) - #dex);
			}
			[*]
			{
				alteration = alter_intelligence;
				duration = #infinite;
				value = (((#magic*0.09)+10) - #int);
			}
			[*]
			{
				alteration = alter_max_mana;
				duration = #infinite;
				value = ((#magic*19) - #maxmana);
			}
			[*]
			{
				alteration = alter_mana;
				duration = 1.0;
				value = (#magic*19);
			}
		}
	}
}
