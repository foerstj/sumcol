[t:template,n:gremal_killer_re_summon]
{
	specializes = gremal_killer_base;

	doc = "[summon] Killer Gremal";
	aspect:experience_value = 0;
	[inventory] { [pcontent] { /* ERASED */ } }

	// The enemy always flees, which makes it rather useless as a summon.
	// I prefer to keep the creature's flavor, but tbf the spell desc says "to guard the caster", so...
	mind:on_enemy_entered_ocz_flee = false;  // Just like the original summon creature
	// (Sadly flee_count didn't seem to work.)
}
